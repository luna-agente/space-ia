[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1"]

[node name="PauseMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 1
script = ExtResource("1")
ui_manager_path = NodePath("../../UIManager")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -180.0
offset_right = 220.0
offset_bottom = 180.0

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 30

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "PAUSADO"
horizontal_alignment = 1

[node name="Resume" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 55)
text = "Continuar"

[node name="Quit" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 55)
text = "Sair do jogo"

[node name="Hint" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Esc para continuar"
horizontal_alignment = 1

[connection signal="pressed" from="Panel/Margin/VBox/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/Quit" to="." method="_on_quit_pressed"]
